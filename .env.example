# Copy this file to .env and fill in real values. Never commit the real .env.

# Required for AI structural analysis. If left unset, the tool still works
# fully via the deterministic fallback parser -- Gemini is optional, not
# a hard dependency. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use for structural classification. This is the
# ONLY place the model name is configured -- it is never hard-coded
# anywhere else in the codebase, so upgrading is a config change, not a
# code change.
#
# Current default: gemini-3.6-flash (GA Flash-class model, good balance
# of speed/cost/accuracy for a classification task like this one).
#
# Google regularly retires older models (gemini-2.0-flash and
# gemini-2.5-flash are both being shut down in 2026) and ships new ones.
# Before deploying, check the current model list and pricing at:
#   https://ai.google.dev/gemini-api/docs/changelog
#   https://ai.google.dev/gemini-api/docs/models
# and update this value if a newer/cheaper Flash-class model is GA.
GEMINI_MODEL=gemini-3.6-flash

# Optional: enables /debug/raw, /debug/chunks, /debug/json, /debug/html
# introspection endpoints. Leave false in any publicly reachable
# deployment -- these expose the last request's full content in memory.
DEBUG_MODE=false

# Optional: port the Flask/gunicorn server listens on.
PORT=5000
